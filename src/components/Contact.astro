---
import { TURNSTILE_SITE_KEY } from 'astro:env/client';
import ArrowIcon from './ArrowIcon.astro';
import { getSite } from '../lib/site';
import SplitHeading from './SplitHeading.astro';
import { isPlaceholder, mailHref, telHref } from '../lib/contact-info';

const c = await getSite('contact');
---
<section class="sec contact" id="kontakt">
  <div class="wrap contact-grid">
    <div>
      <div class="eyebrow rv">{c.eyebrow}</div>
      <SplitHeading heading={c.heading} headingEm={c.headingEm} />
      <p class="contact-lead rv d2">{c.lead}</p>
      <div class="cinfo rv d2">
        {isPlaceholder(c.email)
          ? <div class="lnk"><span>E-mail</span><b>{c.email}</b></div>
          : <a class="lnk" href={mailHref(c.email)}><span>E-mail</span><b>{c.email}</b></a>}
        {isPlaceholder(c.phone)
          ? <div class="lnk"><span>Telefon</span><b>{c.phone}</b></div>
          : <a class="lnk" href={telHref(c.phone)}><span>Telefon</span><b>{c.phone}</b></a>}
        <div><span>Obszar</span><p style="margin: 0">{c.area}</p></div>
        <div><span>Godziny</span><p style="margin: 0">{c.hours}</p></div>
      </div>
    </div>

    <div class="rv d1">
      <form class="form" id="contact-form" action="/api/contact" method="post" enctype="multipart/form-data" data-sitekey={TURNSTILE_SITE_KEY}>
        <div class="row2">
          <label class="fld"><input type="text" name="name" required placeholder=" " autocomplete="given-name" maxlength="100" /><span>Imię *</span></label>
          <label class="fld"><input type="email" name="email" required placeholder=" " autocomplete="email" maxlength="200" /><span>E-mail *</span></label>
        </div>
        <label class="fld"><input type="tel" name="phone" placeholder=" " autocomplete="tel" maxlength="40" /><span>Telefon (opcjonalnie)</span></label>
        <label class="fld"><textarea name="message" required placeholder=" " maxlength="3000"></textarea><span>Wiadomość *</span></label>

        <label class="drop" id="drop">
          <input type="file" name="image" accept="image/jpeg,image/png,image/webp" aria-label="Dołącz zdjęcie wnętrza" />
          <span class="drop-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.6"></rect><circle cx="9" cy="10.5" r="1.8" stroke="currentColor" stroke-width="1.6"></circle><path d="m4 17 5-4.5 4 3.5 3-2.5 4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg></span>
          <span><b>Dołącz zdjęcie wnętrza</b><small>Przeciągnij plik tutaj lub kliknij · JPG, PNG, WebP · 1 zdjęcie, do 5 MB</small></span>
        </label>
        <div class="thumbs" id="thumbs" hidden></div>

        <!-- Honeypot: ukryte pole, boty je wypełniają -->
        <div class="hp" aria-hidden="true"><label>Nie wypełniaj tego pola<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div id="turnstile-slot" data-turnstile></div>

        <p class="form-error" id="form-error" role="alert" hidden></p>
        <noscript><p class="form-error">Weryfikacja antyspamowa wymaga JavaScriptu — włącz go lub napisz do nas e-mailem.</p></noscript>

        <div class="form-foot">
          <small>Wysyłając formularz, zgadzasz się na kontakt w sprawie zapytania. [LINK DO POLITYKI PRYWATNOŚCI]</small>
          <button class="btn btn-dark" type="submit"><span>Wyślij zapytanie</span><ArrowIcon /></button>
        </div>
      </form>

      <div class="sent" id="sent" role="status" hidden>
        <div class="sent-ic"><svg width="38" height="38" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5 10 17l9-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
        <h3>Dziękujemy!</h3>
        <p>Zapytanie dotarło do Nordleaf. Odezwiemy się z propozycją i ustalimy szczegóły.</p>
        <button class="btn btn-ghost btn-sm" type="button" id="sent-reset"><span>Wyślij kolejne zapytanie</span></button>
      </div>
    </div>
  </div>
</section>
