---
import { getSite } from '../lib/site';

const about = await getSite('about');
const icons = {
  sun: '<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>',
  pot: '<path d="M5 9h14l-1.6 10.2a2 2 0 0 1-2 1.8H8.6a2 2 0 0 1-2-1.8L5 9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path><path d="M4 9h16M12 9V5m0 0c0-1.7 1.3-3 3-3 0 1.7-1.3 3-3 3Zm0 0c0-1.7-1.3-3-3-3 0 1.7 1.3 3 3 3Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>',
  set: '<rect x="3" y="3" width="7.5" height="7.5" rx="2" stroke="currentColor" stroke-width="1.6"></rect><rect x="13.5" y="3" width="7.5" height="7.5" rx="2" stroke="currentColor" stroke-width="1.6"></rect><rect x="3" y="13.5" width="7.5" height="7.5" rx="2" stroke="currentColor" stroke-width="1.6"></rect><path d="M17.25 14v6.5M14 17.25h6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>',
} as const;
---
<section class="sec about" id="o-nas">
  <div class="wrap about-grid">
    <div>
      <div class="eyebrow rv">{about.eyebrow}</div>
      <h2 class="rv d1">{about.heading} <em>{about.headingEm}</em></h2>
    </div>
    <div>
      <p class="about-lead rv">{about.lead}</p>
      {about.features.map((f, i) => (
        <div class={`feat rv d${i + 1}`}>
          <div class="feat-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={icons[f.icon]} /></div>
          <div><h3>{f.title}</h3><p>{f.text}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
