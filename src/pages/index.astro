---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Offer from '../components/Offer.astro';
import Band from '../components/Band.astro';
import Steps from '../components/Steps.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Nordleaf — rośliny i donice na zamówienie"
  description="Rośliny, donice i gotowe zestawy na zamówienie do mieszkań, biur i lokali. Napisz, czego szukasz — resztę ustalimy razem."
>
  <Header />
  <main>
    <Hero />
    <About />
    <Offer />
    <Band />
    <Steps />
    <div class="sv" aria-hidden="true">
      <div class="sv-row sv-a">{['Rośliny', 'Donice', 'Zestawy', 'Rośliny', 'Donice', 'Zestawy', 'Rośliny', 'Donice'].map((t, i) => <span class={i % 2 === 1 ? 'f' : undefined}>{t}</span>)}</div>
      <div class="sv-row sv-b">{['Mieszkania', 'Biura', 'Lokale', 'Mieszkania', 'Biura', 'Lokale', 'Mieszkania', 'Biura'].map((t, i) => <span class={i % 2 === 0 ? 'f' : undefined}>{t}</span>)}</div>
    </div>
    <Contact />
  </main>
  <Footer />
</Base>
