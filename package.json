{
  "name": "nordleaf",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "vendor:decap": "node -e \"const fs=require('fs');fs.rmSync('public/admin/vendor',{recursive:true,force:true});fs.cpSync('node_modules/decap-cms/dist','public/admin/vendor',{recursive:true,filter:s=>!s.endsWith('.map')&&!/(^|\\\\/)(\\\\d+\\\\.)?cms\\\\.js(\\\\.LICENSE\\\\.txt)?$/.test(s)})\"",
    "predev": "npm run vendor:decap",
    "prebuild": "npm run vendor:decap"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.4.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "decap-cms": "3.17.3",
    "decap-server": "^3.11.6",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true
  }
}
